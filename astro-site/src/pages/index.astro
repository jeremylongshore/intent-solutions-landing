---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer';

const receipts = [
  {
    label: 'Intent Labs',
    title: 'The result, including the failures.',
    body: 'Current evaluations, evidence bundles, freshness, and the rows that did not pass.',
    href: 'https://labs.intentsolutions.io/results/',
    cta: 'See current results',
  },
  {
    label: 'Evals',
    title: 'The definition behind the result.',
    body: 'Versioned meanings for verdicts, runtime receipts, review states, and regressions.',
    href: 'https://evals.intentsolutions.io/',
    cta: 'Read the definitions',
  },
  {
    label: 'Marketplace',
    title: 'Tools built in the open.',
    body: 'A public marketplace of plugins and agent skills that can be inspected before adoption.',
    href: 'https://tonsofskills.com/',
    cta: 'Explore the marketplace',
  },
  {
    label: 'Demos',
    title: 'Working systems, not pitch-deck mockups.',
    body: 'A catalog of systems and experiments you can open, use, and judge for yourself.',
    href: 'https://demos.intentsolutions.io/',
    cta: 'Open the demos',
  },
];

const method = [
  {
    number: '01',
    title: 'Frame',
    body: 'Agree on the workflow, baseline, definition of done, human decision rights, and handoff responsibilities before building.',
  },
  {
    number: '02',
    title: 'Build',
    body: 'Build integrations, context, tools, and exception paths with the people who will use and maintain the system.',
  },
  {
    number: '03',
    title: 'Prove',
    body: 'Evaluate real work against the agreed test. Record failures and limitations; publish evidence where permission allows.',
  },
  {
    number: '04',
    title: 'Operate',
    body: 'Establish monitoring, rollback, and operating ownership. Transfer the documentation, access, and knowledge your team needs to run and improve the system.',
  },
];
---

<Layout
  title="Intent Solutions | Applied AI Engineering"
  description="Intent Solutions turns AI capability into reliable, measurable production work. We build with your team, evaluate real workflows, and transfer operating knowledge."
>
  <SiteNav />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-wash" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Bring us the work <span>you need AI to do.</span></h1>
          <p class="hero-lede">
            Intent Solutions is an applied AI engineering company that turns AI capability into reliable,
            measurable production work. We build with your team, test against your work, and transfer
            the knowledge needed to operate and evolve the system.
          </p>
          <div class="actions">
            <a class="button primary" href="/contact/?door=outcome">Request an outcome</a>
            <a class="button secondary" href="#proof">Inspect the work</a>
          </div>
          <p class="hero-next">Start with the problem. You do not need a model or a technical specification picked out.</p>
          <a class="quiet-link" href="https://learn.intentsolutions.io/">Here to build with us? Explore the practice <span aria-hidden="true">→</span></a>
        </div>

        <aside class="system-map" aria-label="What we define with you">
          <h2 class="map-title">What does done look like?</h2>
          <div class="map-node map-parent">
            <strong>The work</strong>
            <p>A task your team needs completed, the information it depends on, and what must stay under human control.</p>
          </div>
          <div class="map-connector" aria-hidden="true"><span></span></div>
          <div class="map-pair">
            <a class="map-node" href="#proof">
              <strong>The evidence</strong>
              <p>A way to check the result, including what failed.</p>
            </a>
            <a class="map-node" href="#method">
              <strong>The operation</strong>
              <p>An owner, monitoring, a failure response, and knowledge your team can carry forward.</p>
            </a>
          </div>
          <div class="map-separate">
            <a class="map-node" href="/contact/?door=outcome">
              <strong>The next step</strong>
              <p>Send the outcome you need. We review the request and answer whether it is a fit.</p>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section id="proof" class="proof section" aria-labelledby="proof-title">
      <div class="wrap">
        <div class="proof-intro">
          <div class="section-head left">
            <h2 id="proof-title">See what ran. <span>Check what happened.</span></h2>
          </div>
          <p>
            A demo shows behavior. A test checks a claim. Our public work gives you both to inspect
            before you decide to work with us. It is evidence of our method, not a promise about your result.
          </p>
        </div>
        <article class="proof-specimen" aria-labelledby="specimen-title">
          <div>
            <h3 id="specimen-title">A failed evaluation stays in the record.</h3>
            <p>This published Labs record shows the gate, its decision, and when it ran. Open the bundle to inspect the result in context.</p>
            <a class="button secondary" href="https://labs.intentsolutions.io/results/jrig/sha256-4668fdaa17dc9d7b330fe84886fb69535516cf39226c030b001571cf818d25b1/">Inspect this evaluation</a>
          </div>
          <dl>
            <div><dt>Gate</dt><dd><code>databricks-cluster-forensics</code></dd></div>
            <div><dt>Recorded decision</dt><dd class="decision">Fail</dd></div>
            <div><dt>Evaluated</dt><dd><time datetime="2026-09-12T04:06:46.451Z">12 September 2026 · 04:06 UTC</time></dd></div>
            <div><dt>Definition</dt><dd><a href="https://evals.intentsolutions.io/gate-result/v1">gate-result/v1</a></dd></div>
          </dl>
          <p class="specimen-note">Dated example, checked 12 September 2026. This is one gate result, not a verdict on an entire system. <a href="https://labs.intentsolutions.io/results/">See current results</a>.</p>
        </article>
        <div class="receipt-grid">
          {receipts.map((receipt) => (
            <a class="receipt" href={receipt.href}>
              <span class="receipt-label">{receipt.label}</span>
              <h3>{receipt.title}</h3>
              <p>{receipt.body}</p>
              <strong>{receipt.cta} <span aria-hidden="true">↗</span></strong>
            </a>
          ))}
        </div>
        <p class="field-note-link">
          Engineering creates evidence. Evidence informs demos, teaching, and reusable tools.
          <a href="https://startaitools.com/deployment-thesis/">See how the work connects <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </section>

    <section id="method" class="method section" aria-labelledby="method-title">
      <div class="wrap method-grid">
        <div class="section-head left method-head">
          <h2 id="method-title">The tools can change. The discipline stays.</h2>
          <p>
            The model follows the task, your data constraints, and the tests it needs to pass.
            We agree on ownership, governance, knowledge transfer, and an exit path from the start.
            Your team should be able to run and improve the system with the agreed handoff materials.
          </p>
        </div>
        <ol class="method-list">
          {method.map((step) => (
            <li>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="team section" aria-labelledby="team-title">
      <div class="wrap team-grid">
        <p class="team-mark" aria-hidden="true">IS</p>
        <div>
          <h2 id="team-title">The systems carry one name. The work is done by a team.</h2>
          <p>
            Jeremy Longshore founded Intent Solutions. Today, engineers, operators, instructors, and project leaders
            define, build, test, teach, and run the work together. Models and providers remain components; the team and
            its operating standard are what make the work durable. The same engineering can become a
            permitted demo, a lesson in Learn, a reusable tool, or a focused product.
          </p>
          <a href="/about/#team">See the people and the practice <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <video autoplay muted loop playsinline aria-hidden="true">
        <source src="/astronaut.mp4" type="video/mp4" />
      </video>
      <div class="closing-overlay" aria-hidden="true"></div>
      <div class="wrap closing-copy">
        <h2 id="closing-title">What work needs to change?</h2>
        <p>Tell us what your team does today and what a useful result would look like. We review the fit before proposing the work.</p>
        <div class="actions">
          <a class="button primary" href="/contact/?door=outcome">Request an outcome</a>
          <a class="button secondary" href="https://labs.intentsolutions.io/start/">Learn how we evaluate</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <nav class="mobile-outcome-action" aria-label="Quick action">
    <a class="button primary" href="/contact/?door=outcome">Request an outcome</a>
  </nav>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #09090b; }
  :global(*) { box-sizing: border-box; }

  .wrap { width: min(72rem, calc(100% - 2.5rem)); margin: 0 auto; }
  .hero-next { color: var(--intent-muted); max-width: 55ch; font-size: 0.9rem; line-height: 1.65; }
  .map-title { margin: 0 0 1.4rem; font-family: 'Syne', sans-serif; font-size: 1.4rem; color: #fafafa; line-height: 1.25; }
  .section { padding: clamp(3.5rem, 6vw, 5.5rem) 0; }

  .hero {
    position: relative;
    padding: clamp(3rem, 5vw, 5rem) 0;
    overflow: hidden;
    background: #09090b url('/images/cosmic-bg-dark.jpg') center / cover no-repeat;
    border-bottom: 1px solid rgba(63, 63, 70, 0.5);
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(9,9,11,0.98) 0%, rgba(9,9,11,0.88) 43%, rgba(9,9,11,0.56) 100%),
      linear-gradient(0deg, #09090b 0%, transparent 26%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    z-index: 1;
  }

  .kicker,
  .receipt-label,
  .map-label,
  .map-node > span,
  .map-separate > span {
    color: #fb923c;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 47rem;
    margin: 1rem 0 1.5rem;
    color: #fafafa;
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .hero-copy h1 span,
  .proof-intro h2 span { color: #ff7a1a; }

  .hero-lede {
    max-width: 42rem;
    margin: 0 0 2rem;
    color: #d4d4d8;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.75;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.72rem 1.15rem;
    border: 1px solid transparent;
    border-radius: 0.48rem;
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .button:hover,
  .button:focus-visible { transform: translateY(-1px); }
  .button.primary { background: #f97316; color: #09090b; }
  .button.primary:hover,
  .button.primary:focus-visible { background: #fb923c; }
  .button.secondary { background: rgba(9,9,11,0.54); border-color: #52525b; color: #fafafa; }
  .button.secondary:hover,
  .button.secondary:focus-visible { border-color: #fb923c; }

  .quiet-link {
    min-height: 44px;
    align-items: center;
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.4rem;
    color: #a1a1aa;
    font-size: 0.82rem;
    text-decoration: none;
  }
  .quiet-link:hover,
  .quiet-link:focus-visible { color: #fafafa; }

  .system-map {
    padding: 1.25rem;
    background: #09090b;
    border: 1px solid rgba(82, 82, 91, 0.72);
    border-radius: 1rem;
  }

  .map-label { display: block; margin: 0 0 1rem; color: var(--intent-muted); }

  .map-node {
    display: block;
    padding: 1rem;
    background: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 0.7rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  a.map-node:hover,
  a.map-node:focus-visible { border-color: #fb923c; transform: translateY(-2px); }
  .map-parent { border-color: rgba(249, 115, 22, 0.55); }
  .map-node > span { display: block; margin-bottom: 0.45rem; }
  .map-node strong { display: block; color: #fafafa; font-family: 'Syne', system-ui, sans-serif; font-size: 1rem; }
  .map-node p { margin: 0.3rem 0 0; color: #a1a1aa; font-size: 0.78rem; line-height: 1.5; }

  .map-connector { display: flex; justify-content: center; height: 1.5rem; }
  .map-connector span { width: 1px; background: #52525b; }
  .map-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .map-separate { margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px dashed #52525b; }
  .map-separate > span { display: block; margin-bottom: 0.65rem; color: var(--intent-muted); }

  .section-head { max-width: 47rem; margin: 0 auto 3rem; text-align: center; }
  .section-head.left { margin-left: 0; text-align: left; }
  .section-head h2,
  .team h2,
  .closing h2 {
    overflow-wrap: anywhere;
    margin: 0.8rem 0 1rem;
    color: #fafafa;
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .section-head > p:last-child { color: #a1a1aa; font-size: 1rem; line-height: 1.7; }


  .proof { background: #09090b; }
  .proof-specimen { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; padding: clamp(1.25rem, 3vw, 2.5rem); margin-bottom: 2.5rem; border: 1px solid #52525b; background: #101012; }
  .proof-specimen h3 { margin: 0 0 1rem; font-family: 'Syne', system-ui, sans-serif; color: #fafafa; font-size: clamp(1.3rem, 2.2vw, 1.8rem); line-height: 1.25; }
  .proof-specimen p { color: var(--intent-muted); line-height: 1.7; }
  .proof-specimen dl { margin: 0; min-width: 0; }
  .proof-specimen dl > div { padding: 0.8rem 0; border-bottom: 1px solid #3f3f46; }
  .proof-specimen dt { font-size: 0.8rem; color: var(--intent-muted); }
  .proof-specimen dd { margin: 0.35rem 0 0; font-size: 0.9rem; color: #fafafa; overflow-wrap: anywhere; }
  .proof-specimen dd.decision { color: #fb923c; font-weight: 700; }
  .proof-specimen a:not(.button) { color: #d4d4d8; text-underline-offset: 0.2em; }
  .proof-specimen .specimen-note { grid-column: 1 / -1; margin: 0; max-width: 70ch; font-size: 0.8rem; }
  .proof-intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); align-items: end; gap: 4rem; margin-bottom: 3rem; }
  .proof-intro .section-head { margin-bottom: 0; }
  .proof-intro > p { margin: 0 0 0.35rem; color: #a1a1aa; line-height: 1.75; }
  .receipt-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid #3f3f46; border-left: 1px solid #3f3f46; }
  .receipt {
    min-height: 16rem;
    padding: 1.7rem;
    border-right: 1px solid #3f3f46;
    border-bottom: 1px solid #3f3f46;
    color: inherit;
    text-decoration: none;
    transition: background 160ms ease;
  }
  .receipt:hover,
  .receipt:focus-visible { background: #18181b; }
  .receipt h3 { max-width: 28rem; margin: 1.5rem 0 0.7rem; color: #fafafa; font-family: 'Syne', system-ui, sans-serif; font-size: 1.25rem; }
  .receipt p { max-width: 30rem; margin: 0 0 1.4rem; color: #a1a1aa; font-size: 0.88rem; line-height: 1.65; }
  .receipt strong { color: #fb923c; font-size: 0.8rem; }
  .field-note-link { margin: 1.5rem 0 0; color: var(--intent-muted); font-size: 0.82rem; text-align: right; }
  .field-note-link a { color: #d4d4d8; text-decoration: none; }
  .field-note-link a:hover,
  .field-note-link a:focus-visible { color: #fb923c; }

  .method { background: #101012; border-top: 1px solid rgba(63,63,70,0.5); border-bottom: 1px solid rgba(63,63,70,0.5); }
  .method-grid { display: grid; grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.2fr); gap: clamp(3rem, 8vw, 8rem); }
  .method-head { position: sticky; top: 8rem; align-self: start; }
  .method-list { margin: 0; padding: 0; list-style: none; }
  .method-list li { display: grid; grid-template-columns: 3rem 1fr; gap: 1.2rem; padding: 1.6rem 0; border-top: 1px solid #3f3f46; }
  .method-list li:last-child { border-bottom: 1px solid #3f3f46; }
  .method-list > li > span { color: #fb923c; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; }
  .method-list h3 { margin: 0 0 0.45rem; color: #fafafa; font-family: 'Syne', system-ui, sans-serif; font-size: 1.2rem; }
  .method-list p { margin: 0; color: #a1a1aa; font-size: 0.9rem; line-height: 1.7; }

  .team { background: #09090b; }
  .team-grid { display: grid; grid-template-columns: 10rem minmax(0, 45rem); align-items: start; justify-content: center; gap: clamp(2rem, 6vw, 5rem); }
  .team-mark { margin: 0; color: rgba(249,115,22,0.16); font-family: 'Syne', system-ui, sans-serif; font-size: clamp(5rem, 12vw, 9rem); font-weight: 800; letter-spacing: -0.08em; line-height: 0.8; }
  .team h2 { font-size: clamp(1.8rem, 3.4vw, 2.8rem); }
  .team div > p:not(.kicker) { color: #a1a1aa; line-height: 1.75; }
  .team a { color: #fb923c; font-size: 0.84rem; font-weight: 700; text-decoration: none; }

  .closing { position: relative; min-height: 37rem; display: grid; place-items: center; overflow: hidden; text-align: center; }
  .closing video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .closing-overlay { position: absolute; inset: 0; background: rgba(9,9,11,0.62); }
  .closing-copy { position: relative; max-width: 52rem; z-index: 1; }
  .closing-copy > p:not(.kicker) { max-width: 38rem; margin: 0 auto 2rem; color: #d4d4d8; line-height: 1.7; }
  .closing .actions { justify-content: center; }

  a:focus-visible { outline: 2px solid #fb923c; outline-offset: 4px; }

  @media (max-width: 880px) {
    .hero-grid,
    .proof-intro,
    .method-grid { grid-template-columns: minmax(0, 1fr); }
    .system-map { max-width: 38rem; }
    .proof-intro { gap: 0.5rem; }
    .method-head { position: static; }
  }

  .mobile-outcome-action { display: none; }

  @media (max-width: 620px) {
    :global(body) { padding-bottom: calc(4.75rem + env(safe-area-inset-bottom)); }
    .wrap { width: min(100% - 1.5rem, 72rem); }
    .hero { min-height: auto; padding-top: 4rem; }
    .hero-copy h1 { font-size: clamp(2rem, 8.8vw, 3.4rem); }
    .map-pair,
    .proof-specimen,
    .receipt-grid { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: 1fr; }
    .team-mark { font-size: 5rem; }
    .field-note-link { text-align: left; }
    .mobile-outcome-action {
      position: fixed;
      z-index: 80;
      right: 0;
      bottom: 0;
      left: 0;
      display: block;
      padding: 0.65rem 0.75rem max(0.65rem, env(safe-area-inset-bottom));
      border-top: 1px solid #3f3f46;
      background: rgba(9, 9, 11, 0.94);
      backdrop-filter: blur(12px);
    }
    .mobile-outcome-action .button { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .button,
    .map-node { transition: none; }
    .closing video { display: none; }
    .closing { background: #18181b url('/images/hero-fallback.jpg') center / cover no-repeat; }
  }
</style>
