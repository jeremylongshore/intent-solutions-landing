---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer';

const receipts = [
  {
    label: 'Intent Labs',
    title: 'The result, including the failures.',
    body: 'Current evaluations, evidence bundles, freshness, and the rows that did not pass.',
    href: 'https://labs.intentsolutions.io/results/',
    cta: 'See current results at Intent Labs',
  },
  {
    label: 'Evals',
    title: 'The definition behind the result.',
    body: 'Versioned meanings for verdicts, runtime receipts, review states, and regressions.',
    href: 'https://evals.intentsolutions.io/',
    cta: 'Read the definitions in Evals',
  },
  {
    label: 'Source',
    title: 'The code behind the work.',
    body: 'Our public repositories on GitHub, with the commit and review history attached.',
    href: 'https://github.com/intent-solutions-io',
    cta: 'Browse the source on GitHub',
  },
  {
    label: 'Demos',
    title: 'Find a demo that fits your work.',
    body: 'Browse business tools, industry workflows and technical examples. Each page explains what you can try.',
    href: 'https://demos.intentsolutions.io/',
    cta: 'Open Intent Solutions demos',
  },
];

const method = [
  {
    number: '01',
    title: 'Frame',
    body: 'Agree on the workflow, baseline, definition of done, human decision rights, and handoff responsibilities before building.',
  },
  {
    number: '02',
    title: 'Build',
    body: 'Build integrations, context, tools, and exception paths with the people who will use and maintain the system.',
  },
  {
    number: '03',
    title: 'Prove',
    body: 'Evaluate real work against the agreed test. Record failures and limitations; publish evidence where permission allows.',
  },
  {
    number: '04',
    title: 'Operate',
    body: 'Establish monitoring, rollback, and operating ownership. Transfer the documentation, access, and knowledge your team needs to run and improve the system.',
  },
];
---

<Layout
  title="Intent Solutions | Applied AI Engineering"
  description="Intent Solutions turns AI capability into reliable, measurable production work. We build with your team, evaluate real workflows, and transfer operating knowledge."
>
  <SiteNav />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-wash" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Bring us the work <span>you need AI to do.</span></h1>
          <p class="hero-lede">
            Intent Solutions is an applied AI engineering company. We turn AI capability into reliable,
            measurable production work: built with your team, tested against your work, and handed over
            for you to run and improve.
          </p>
          <div class="actions">
            <a class="button primary" href="/contact/?door=outcome">Request an outcome</a>
            <a class="button secondary" href="/projects/">Explore everything</a>
          </div>
          <div class="partner-credential">
            <img
              src="/images/credentials/claude-select-partner.svg"
              alt="Intent Solutions — Claude Partner Network Select Services Partner"
              width="600"
              height="190"
              loading="eager"
              decoding="async"
            />
            <p>Claude Partner Network, Select tier.<br />Model-agnostic engineering, built around your work.</p>
          </div>
          <p class="hero-next">Start with the problem. You do not need a model or a technical specification picked out.</p>
          <a class="quiet-link" href="https://learn.intentsolutions.io/">Here to build with us? Explore the practice</a>
        </div>

        <aside class="system-map" aria-label="What we define with you">
          <h2 class="map-title">What does done look like?</h2>
          <div class="map-node map-parent">
            <strong>The work</strong>
            <p>A task your team needs completed, the information it depends on, and what must stay under human control.</p>
          </div>
          <div class="map-connector" aria-hidden="true"><span></span></div>
          <div class="map-pair">
            <a class="map-node" href="#proof">
              <strong>The evidence</strong>
              <p>A way to check the result, including what failed.</p>
            </a>
            <a class="map-node" href="#method">
              <strong>The operation</strong>
              <p>An owner, monitoring, a failure response, and knowledge your team can carry forward.</p>
            </a>
          </div>
          <div class="map-separate">
            <a class="map-node" href="/contact/?door=outcome">
              <strong>The next step</strong>
              <p>Send the outcome you need. We review the request and answer whether it is a fit.</p>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section id="proof" class="proof section" aria-labelledby="proof-title">
      <div class="wrap">
        <div class="proof-intro">
          <div class="section-head left">
            <h2 id="proof-title">See what ran. Check what happened.</h2>
          </div>
          <p>
            A demo shows behavior. A test checks a claim. Our public work gives you both to inspect
            before you decide to work with us. It is evidence of our method, not a promise about your result.
          </p>
        </div>
        <article class="proof-specimen" aria-labelledby="specimen-title">
          <div>
            <h3 id="specimen-title">Inspect how we build before we build for you.</h3>
            <p>Tons of Skills, our flagship open-source work, is a public marketplace of plugins and agent skills for AI coding agents. The code, the change history and the review trail are all open, so you can judge the work itself.</p>
            <div class="demo-actions">
              <a class="button secondary" href="https://tonsofskills.com/">Explore Tons of Skills</a>
              <a href="https://github.com/jeremylongshore/tons-of-skills-marketplace">Read the source</a>
            </div>
          </div>
          <dl>
            <div><dt>What it is</dt><dd>Plugins and agent skills for AI coding agents</dd></div>
            <div><dt>Source</dt><dd><a href="https://github.com/jeremylongshore/tons-of-skills-marketplace"><code>tons-of-skills-marketplace</code></a> on GitHub</dd></div>
            <div><dt>License</dt><dd>MIT</dd></div>
            <div><dt>Maintained by</dt><dd>Intent Solutions</dd></div>
          </dl>
          <p class="specimen-note">The catalog changes often, so current figures live on the site itself. Evaluation results, including the ones that did not pass, are published at <a href="https://labs.intentsolutions.io/results/">Intent Labs</a>.</p>
        </article>
        <article class="featured-demo" aria-labelledby="outreach-demo-title">
          <div>
            <h3 id="outreach-demo-title">Intent Outreach, a real estate demo</h3>
            <p>Shape a workflow around your market, buy box or relationships. Explore example shortlists, client briefs and follow-up queues, then send us the version you want to build.</p>
            <p class="demo-boundary">Interactive examples use fictional data. A separate property-data sandbox lets you inspect the connection.</p>
          </div>
          <div class="demo-actions">
            <a class="button primary" href="https://demos.intentsolutions.io/intentoutreach/">Try Intent Outreach</a>
            <a href="https://demos.intentsolutions.io/#catalog">Browse all demos</a>
          </div>
        </article>
        <div class="receipt-grid">
          {receipts.map((receipt) => (
            <a class="receipt" href={receipt.href}>
              <h3>{receipt.title}</h3>
              <p>{receipt.body}</p>
              <strong>{receipt.cta}</strong>
            </a>
          ))}
        </div>
        <p class="field-note-link">
          Engineering creates evidence. Evidence informs demos, teaching, and reusable tools.
          <a href="https://startaitools.com/deployment-thesis/">See how the work connects</a>
        </p>
      </div>
    </section>

    <section id="method" class="method section" aria-labelledby="method-title">
      <div class="wrap method-grid">
        <div class="section-head left method-head">
          <h2 id="method-title">The tools can change. The discipline stays.</h2>
          <p>
            The model follows the task, your data constraints, and the tests it needs to pass.
            We agree on ownership, governance, knowledge transfer, and an exit path from the start.
            Your team should be able to run and improve the system with the agreed handoff materials.
          </p>
        </div>
        <ol class="method-list">
          {method.map((step) => (
            <li>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="team section" aria-labelledby="team-title">
      <div class="wrap team-grid">
        <p class="team-mark" aria-hidden="true">IS</p>
        <div>
          <h2 id="team-title">The systems carry one name. The work is done by a team.</h2>
          <p>
            Jeremy Longshore founded Intent Solutions. Today, engineers, operators, instructors, and project leaders
            define, build, test, teach, and run the work together. Models and providers remain components; the team and
            its operating standard are what make the work durable. The same engineering can become a
            permitted demo, a lesson in Learn, a reusable tool, or a focused product.
          </p>
          <a href="/estate/">See how the work connects</a>
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <video autoplay muted loop playsinline poster="/images/hero-fallback.jpg" aria-hidden="true">
        <source src="/astronaut.mp4" type="video/mp4" />
      </video>
      <div class="closing-overlay" aria-hidden="true"></div>
      <div class="wrap closing-copy">
        <h2 id="closing-title">What work needs to change?</h2>
        <p>Tell us what your team does today and what a useful result would look like. We review the fit before proposing the work.</p>
        <div class="actions">
          <a class="button primary" href="/contact/?door=outcome">Request an outcome</a>
          <a class="button secondary" href="https://labs.intentsolutions.io/start/">Learn how we evaluate</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <nav class="mobile-outcome-action" aria-label="Quick action">
    <a class="button primary" href="/contact/?door=outcome">Request an outcome</a>
  </nav>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: var(--intent-ink); }
  :global(*) { box-sizing: border-box; }

  .wrap { width: min(72rem, calc(100% - 2.5rem)); margin: 0 auto; }
  .hero-next { color: var(--intent-muted); max-width: 55ch; font-size: 0.9rem; line-height: 1.65; }
  .partner-credential {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin: 1.75rem 0 1.25rem;
  }
  .partner-credential img { display: block; width: min(100%, 17rem); height: auto; flex-shrink: 0; }
  .partner-credential p { flex: 1 1 12rem; margin: 0; color: var(--intent-muted); font-size: 0.82rem; line-height: 1.65; }
  .map-title { margin: 0 0 1.4rem; font-family: var(--font-display); font-size: 1.4rem; color: var(--intent-text); line-height: 1.25; }
  .section { padding: clamp(3.5rem, 6vw, 5.5rem) 0; }

  .hero {
    position: relative;
    padding: clamp(3rem, 5vw, 5rem) 0;
    overflow: hidden;
    background: var(--intent-ink) url('/images/cosmic-bg-dark.jpg') center / cover no-repeat;
    border-bottom: 1px solid var(--intent-line-soft);
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--intent-ink-98) 0%, var(--intent-ink-88) 43%, var(--intent-ink-56) 100%),
      linear-gradient(0deg, var(--intent-ink) 0%, transparent 26%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    z-index: 1;
  }

  .hero-copy h1 {
    max-width: 47rem;
    min-width: 0;
    margin: 1rem 0 1.5rem;
    color: var(--intent-text);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .hero-copy h1 span { color: var(--intent-brand); }

  .hero-lede {
    max-width: 42rem;
    margin: 0 0 2rem;
    color: var(--intent-text-2);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.72rem 1.15rem;
    border: 1px solid transparent;
    border-radius: 0.48rem;
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .button:hover,
  .button:focus-visible { transform: translateY(-1px); }
  .button:active { transform: translateY(0); }
  .button.primary { background: var(--intent-accent); color: var(--intent-ink); }
  .button.primary:hover,
  .button.primary:focus-visible { background: var(--intent-accent-hi); }
  .button.primary:active { background: var(--intent-accent-lo); }
  .button.secondary { background: transparent; border-color: var(--intent-line-strong); color: var(--intent-text); }
  .button.secondary:hover,
  .button.secondary:focus-visible { border-color: var(--intent-accent-hi); }
  .button.secondary:active { background: var(--intent-surface-2); }

  .quiet-link {
    min-height: 44px;
    align-items: center;
    display: inline-flex;
    margin-top: 1.4rem;
    color: var(--intent-muted);
    font-size: 0.82rem;
    text-decoration: underline;
    text-decoration-color: var(--intent-line-strong);
    text-underline-offset: 0.25em;
    transition: color 160ms ease;
  }
  .quiet-link:hover,
  .quiet-link:focus-visible { color: var(--intent-text); }
  .quiet-link:active { color: var(--intent-accent-hi); }

  .system-map { padding: 0; }

  .map-node {
    display: block;
    padding: 1rem;
    background: var(--intent-surface-2);
    border: 1px solid var(--intent-line);
    border-radius: 0.7rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  a.map-node:hover,
  a.map-node:focus-visible { border-color: var(--intent-accent-hi); transform: translateY(-2px); }
  a.map-node:active { transform: translateY(0); }
  .map-parent { border-color: var(--intent-accent-soft); }
  .map-node strong { display: block; color: var(--intent-text); font-family: var(--font-display); font-size: 1rem; }
  .map-node p { margin: 0.3rem 0 0; color: var(--intent-muted); font-size: 0.78rem; line-height: 1.5; }

  .map-connector { display: flex; justify-content: center; height: 1.5rem; }
  .map-connector span { width: 1px; background: var(--intent-line-strong); }
  .map-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.75rem; }
  .map-separate { margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px dashed var(--intent-line-strong); }

  .section-head { max-width: 47rem; margin: 0 auto 3rem; text-align: center; }
  .section-head.left { margin-left: 0; text-align: left; }
  .section-head h2,
  .team h2,
  .closing h2 {
    min-width: 0;
    overflow-wrap: break-word;
    margin: 0.8rem 0 1rem;
    color: var(--intent-text);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .section-head > p:last-child { color: var(--intent-muted); font-size: 1rem; line-height: 1.7; }

  .proof { background: var(--intent-ink); }
  .proof-specimen { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; padding: clamp(1.25rem, 3vw, 2.5rem); margin-bottom: 2.5rem; border: 1px solid var(--intent-line-strong); background: var(--intent-surface); }
  .proof-specimen h3 { margin: 0 0 1rem; font-family: var(--font-display); color: var(--intent-text); font-size: clamp(1.3rem, 2.2vw, 1.8rem); line-height: 1.25; }
  .proof-specimen p { color: var(--intent-muted); line-height: 1.7; text-wrap: pretty; }
  .proof-specimen dl { margin: 0; min-width: 0; }
  .proof-specimen dl > div { padding: 0.8rem 0; border-bottom: 1px solid var(--intent-line); }
  .proof-specimen dt { font-size: 0.8rem; color: var(--intent-muted); }
  .proof-specimen dd { margin: 0.35rem 0 0; font-size: 0.9rem; color: var(--intent-text); overflow-wrap: anywhere; }
  .proof-specimen .demo-actions { margin-top: 1.5rem; }
  .proof-specimen a:not(.button) { color: var(--intent-text-2); text-decoration: underline; text-decoration-color: var(--intent-line-strong); text-underline-offset: 0.25em; }
  .proof-specimen a:not(.button):hover,
  .proof-specimen a:not(.button):focus-visible { color: var(--intent-accent-hi); }
  .proof-specimen .specimen-note { grid-column: 1 / -1; margin: 0; max-width: 70ch; font-size: 0.8rem; }
  .proof-intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); align-items: end; gap: 4rem; margin-bottom: 3rem; }
  .proof-intro .section-head { margin-bottom: 0; }
  .proof-intro > p { margin: 0 0 0.35rem; color: var(--intent-muted); line-height: 1.75; }
  .featured-demo { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2rem; padding: clamp(1.25rem, 3vw, 2rem); margin: 3.5rem 0; background: var(--intent-surface-2); border-radius: 0.7rem; }
  .featured-demo h3 { margin: 0 0 0.5rem; color: var(--intent-text); font-family: var(--font-display); font-size: 1.6rem; }
  .featured-demo p { color: var(--intent-text-2); line-height: 1.7; max-width: 65ch; }
  .featured-demo .demo-boundary { color: var(--intent-muted); font-size: 0.85rem; }
  .demo-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .demo-actions > a:not(.button) { color: var(--intent-text-2); text-decoration: underline; text-decoration-color: var(--intent-line-strong); text-underline-offset: 0.25em; padding: 0.6rem 0; }
  .demo-actions > a:not(.button):hover,
  .demo-actions > a:not(.button):focus-visible { color: var(--intent-accent-hi); }
  .demo-actions > a:not(.button):active { color: var(--intent-accent-hi); }
  @media (max-width: 768px) { .featured-demo { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
  .receipt-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .receipt {
    min-height: 14rem;
    padding: 1.7rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  .receipt:hover,
  .receipt:focus-visible { background: var(--intent-surface-2); }
  .receipt:active { background: var(--intent-surface-3); }
  .receipt:nth-child(odd) { border-right: 1px solid var(--intent-line); }
  .receipt:nth-child(-n + 2) { border-bottom: 1px solid var(--intent-line); }
  .receipt h3 { max-width: 28rem; margin: 0 0 0.7rem; color: var(--intent-text); font-family: var(--font-display); font-size: 1.25rem; }
  .receipt p { max-width: 30rem; margin: 0 0 1.4rem; color: var(--intent-muted); font-size: 0.88rem; line-height: 1.65; }
  .receipt strong { color: var(--intent-accent-hi); font-size: 0.8rem; }
  .field-note-link { margin: 1.5rem 0 0; color: var(--intent-muted); font-size: 0.82rem; text-align: right; }
  .field-note-link a { color: var(--intent-text-2); text-decoration: underline; text-decoration-color: var(--intent-line-strong); text-underline-offset: 0.25em; }
  .field-note-link a:hover,
  .field-note-link a:focus-visible { color: var(--intent-accent-hi); }

  .method { background: var(--intent-surface); border-top: 1px solid var(--intent-line-soft); border-bottom: 1px solid var(--intent-line-soft); }
  .method-grid { display: grid; grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.2fr); gap: clamp(3rem, 8vw, 8rem); }
  .method-head { position: sticky; top: 8rem; align-self: start; }
  .method-head h2 { font-size: clamp(2rem, 3.4vw, 2.8rem); }
  .method-list { margin: 0; padding: 0; list-style: none; }
  .method-list li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1.2rem; padding: 1.6rem 0; border-top: 1px solid var(--intent-line); }
  .method-list li:last-child { border-bottom: 1px solid var(--intent-line); }
  .method-list > li > span { color: var(--intent-faint); font-size: 1.2rem; line-height: 1.5; font-variant-numeric: tabular-nums; }
  .method-list h3 { margin: 0 0 0.45rem; color: var(--intent-text); font-family: var(--font-display); font-size: 1.2rem; }
  .method-list p { margin: 0; color: var(--intent-muted); font-size: 0.9rem; line-height: 1.7; }

  .team { background: var(--intent-ink); }
  .team-grid { display: grid; grid-template-columns: 10rem minmax(0, 45rem); align-items: start; justify-content: center; gap: clamp(2rem, 6vw, 5rem); }
  .team-mark { margin: 0; color: var(--intent-accent-ghost); font-family: var(--font-display); font-size: clamp(5rem, 12vw, 9rem); font-weight: 800; letter-spacing: -0.08em; line-height: 0.8; }
  .team h2 { font-size: clamp(1.8rem, 3.4vw, 2.8rem); }
  .team div > p { color: var(--intent-muted); line-height: 1.75; }
  .team a { display: inline-flex; align-items: center; min-height: 44px; color: var(--intent-accent-hi); font-size: 0.84rem; font-weight: 700; text-decoration: underline; text-decoration-color: var(--intent-accent-soft); text-underline-offset: 0.25em; }
  .team a:hover,
  .team a:focus-visible { color: var(--intent-text); }

  .closing { position: relative; min-height: 37rem; display: grid; place-items: center; overflow: hidden; text-align: center; }
  .closing video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .closing-overlay { position: absolute; inset: 0; background: var(--intent-ink-62); }
  .closing-copy { position: relative; max-width: 52rem; z-index: 1; }
  .closing-copy > p { max-width: 38rem; margin: 0 auto 2rem; color: var(--intent-text-2); line-height: 1.7; }
  .closing .actions { justify-content: center; }

  a:focus-visible { outline: 2px solid var(--intent-accent-hi); outline-offset: 4px; }

  @media (max-width: 880px) {
    .hero-grid,
    .proof-intro,
    .method-grid { grid-template-columns: minmax(0, 1fr); }
    .system-map { max-width: 38rem; }
    .proof-intro { gap: 0.5rem; }
    .method-head { position: static; }
  }

  .mobile-outcome-action { display: none; }

  @media (max-width: 620px) {
    :global(body) { padding-bottom: calc(4.75rem + env(safe-area-inset-bottom)); }
    .wrap { width: min(100% - 1.5rem, 72rem); }
    .hero { min-height: auto; padding-top: 2.5rem; }
    .hero-copy h1 { font-size: clamp(2rem, 8.8vw, 3.4rem); }
    .map-pair,
    .proof-specimen,
    .receipt-grid { grid-template-columns: minmax(0, 1fr); }
    .receipt:nth-child(odd) { border-right: 0; }
    .receipt:not(:last-child) { border-bottom: 1px solid var(--intent-line); }
