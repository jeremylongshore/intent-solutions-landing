---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero';
import TrustBar from '../components/home/TrustBar.astro';
import Testimonials from '../components/Testimonials';
import ContactCta from '../components/home/ContactCta.astro';
import Footer from '../components/Footer';

const solutions = [
  {
    href: '/#solutions',
    title: 'Claude Code Systems',
    desc: 'Custom setups, curated plugin packs, slash commands, and team training — Claude Code tuned to your stack from day one.',
    cta: 'Book a discovery call',
    ctaHref: 'https://calendar.app.google/Wqbt8EJuEh5xvvV58',
    featured: true,
  },
  {
    href: '/agents',
    title: 'AI Agents',
    desc: 'Custom Intent Agent Models for any workflow.',
  },
  {
    href: '/private-ai',
    title: 'Private AI',
    desc: 'ChatGPT-class experience on your own cloud.',
  },
  {
    href: '/automation',
    title: 'Automation',
    desc: 'n8n workflows that erase manual work.',
  },
  {
    href: '/cloud',
    title: 'Cloud & Data',
    desc: 'Google Cloud-native architectures.',
  },
];

const engagements = [
  { href: '/learn', label: 'Learn',              desc: 'Executive onramps & team enablement' },
  { href: '/colab', label: 'Colab',              desc: 'Implementation partner in your repo', featured: true },
  { href: 'https://whop.com/claude-code-cowork-accelerator/', label: 'Cowork Accelerator', desc: 'Cohort-based building, live sessions', external: true },
];

/* photo omitted → initials placeholder shown until a headshot is added */
const team = [
  {
    photo: '/team/jeremy-longshore.jpeg',
    name: 'Jeremy Longshore',
    role: 'Founder & CEO',
  },
  {
    photo: '/team/opeyemi-ariyo.jpeg',
    name: 'Opeyemi Ariyo',
    role: 'Co-Founder & Chief Technical Officer',
  },
  {
    photo: '/team/pablo-perez.jpeg',
    name: 'Pablo Perez',
    role: 'Co-Founder & Project Manager',
  },
  {
    photo: '/team/max-sheahan.jpeg',
    name: 'Max Sheahan',
    role: 'Lead Instructor',
  },
  {
    photo: '/team/tim-neunzig.png',
    name: 'Tim Neunzig',
    role: 'Head of German Operations',
  },
  {
    photo: '/team/tolulope-ariyo.jpeg',
    name: 'Tolulope Ariyo',
    role: 'Software & Design Engineer',
  },
];

const initials = (name: string) =>
  name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<Layout
  title="Intent Solutions | Intelligent Solutions, Intentional Impact"
  description="We build AI-powered solutions that learn, adapt, and drive real business outcomes — Claude Code systems, AI agents, private AI, and workflow automation."
>
  <SiteNav />

  <Hero client:load />
  <TrustBar />

  <!-- ═══════════ What We Do ═══════════ -->
  <section id="solutions" class="wwd-section" aria-labelledby="wwd-title">
    <!-- Cosmic galaxy backdrop (dimmed) -->
    <div class="wwd-cosmic" aria-hidden="true"></div>
    <div class="wwd-cosmic-scrim" aria-hidden="true"></div>
    <div class="wwd-container">

      <div class="sec-eyebrow" aria-hidden="true">
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">What We Do</span>
        <span class="eyebrow-rule"></span>
      </div>

      <h2 id="wwd-title" class="sec-title">
        AI systems, <span class="hl">built to ship</span>
      </h2>
      <p class="sec-subtitle">Five practices, one team — from Claude Code enablement to production cloud systems.</p>

      <div class="wwd-grid">
        {solutions.map((s, i) => (
          <a
            href={s.featured ? s.ctaHref : s.href}
            target={s.featured ? '_blank' : undefined}
            rel={s.featured ? 'noopener' : undefined}
            class:list={['wwd-card', { 'wwd-card--featured': s.featured }]}
            data-reveal={i}
          >
            {s.featured && (
              <span class="wwd-flag">
                <span class="wwd-diamond">◆</span> Core Practice
              </span>
            )}
            <span class="wwd-icon">
              <img src="/images/logo-mark.png" alt="" width={s.featured ? 30 : 20} height={s.featured ? 30 : 20} aria-hidden="true" />
            </span>
            <h3 class="wwd-name">{s.title}</h3>
            <p class="wwd-desc">{s.desc}</p>
            <span class="wwd-cta">
              {s.featured ? s.cta : 'Learn more'}
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Ways to work with us -->
      <div class="eng-strip" data-reveal="5">
        <p class="eng-label">Ways to work with us</p>
        <div class="eng-row">
          {engagements.map(({ href, label, desc, featured, external }) => (
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              class:list={['eng-card', { 'eng-card--featured': featured }]}
            >
              <span class="eng-name">{label}{external && ' ↗'}</span>
              <span class="eng-desc">{desc}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <Testimonials client:visible />

  <!-- ═══════════ Team ═══════════ -->
  <section id="team" class="team-section" aria-labelledby="team-title">
    <div class="team-container">
      <div class="sec-eyebrow" aria-hidden="true">
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">The Team</span>
        <span class="eyebrow-rule"></span>
      </div>

      <h2 id="team-title" class="sec-title">
        the brains behind <span class="hl">Intent Solutions</span>
      </h2>
      <p class="sec-subtitle">Engineers who build, train, and ship.</p>

      <div class="team-rows">
        {[team.slice(0, 3), team.slice(3)].map((row) => (
          <div class="team-row">
            {row.map((m, i) => (
              <div class="team-card" data-reveal={i}>
                <span class="team-photo-ring">
                  {m.photo ? (
                    <img class="team-photo" src={m.photo} alt={`${m.name}, ${m.role}`} width="112" height="112" loading="lazy" />
                  ) : (
                    <span class="team-photo team-initials" aria-hidden="true">{initials(m.name)}</span>
                  )}
                </span>
                <p class="team-name">{m.name}</p>
                <p class="team-role">{m.role}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCta />
  <Footer />
</Layout>

<style>
  /* ─── Shared section furniture ─── */
  .sec-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .eyebrow-rule {
    display: block;
    height: 1px;
    width: 3.5rem;
    background: linear-gradient(to right, transparent, rgba(249,115,22,0.2));
  }

  .eyebrow-rule:last-child {
    background: linear-gradient(to left, transparent, rgba(249,115,22,0.2));
  }

  .eyebrow-label {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(251 146 60);
  }

  .sec-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    color: rgb(250 250 250);
    text-align: center;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  /* Marker highlight — the signature device */
  .hl {
    background: linear-gradient(120deg, #FF8A2A, #F26205);
    color: rgb(9 9 11);
    padding: 0.02em 0.22em 0.06em;
    border-radius: 8px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .sec-subtitle {
    text-align: center;
    font-size: 0.95rem;
    color: rgb(161 161 170);
    margin-bottom: 3.25rem;
  }

  /* Scroll reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ═══════════ What We Do ═══════════ */
  .wwd-section {
    padding: 6.5rem 0;
    background: rgb(9 9 11);
    border-top: 1px solid rgba(39, 39, 42, 0.5);
    position: relative;
    overflow: hidden;
  }

  /* Galaxy image */
  .wwd-cosmic {
    position: absolute;
    inset: 0;
    background: url('/images/cosmic-bg-dark.jpg') center / cover no-repeat;
    opacity: 0.72;
    pointer-events: none;
  }

  /* Scrim — feathers only the top/bottom edges into the page and adds the
     ember wash; kept light so the galaxy reads bright. Cards carry their
     own dark backdrop, so text stays readable over the brighter image. */
  .wwd-cosmic-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(9 9 11) 0%, rgba(9,9,11,0) 16%, rgba(9,9,11,0) 84%, rgb(9 9 11) 100%),
      radial-gradient(ellipse at 50% 30%, rgba(9,9,11,0.35) 0%, transparent 55%),
      radial-gradient(circle at 82% 8%, rgba(249,115,22,0.06), transparent 55%);
    pointer-events: none;
  }

  .wwd-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
  }

  .wwd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .wwd-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 0.875rem;
    background: rgba(24, 24, 27, 0.65);
    border: 1px solid rgba(39, 39, 42, 0.75);
    backdrop-filter: blur(8px);
    text-decoration: none;
    transition: border-color 0.28s ease, background 0.28s ease, transform 0.22s ease;
  }

  .wwd-card:hover {
    border-color: rgba(249, 115, 22, 0.3);
    background: rgba(24, 24, 27, 0.9);
    transform: translateY(-3px);
  }

  .wwd-card--featured {
    grid-column: span 2;
    background: rgba(18, 18, 20, 0.95);
    border-color: rgba(249, 115, 22, 0.28);
    box-shadow: 0 0 0 1px rgba(249,115,22,0.04), 0 24px 64px rgba(0,0,0,0.5);
  }

  .wwd-card--featured:hover {
    border-color: rgba(249, 115, 22, 0.45);
  }

  .wwd-flag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(251 146 60);
    margin-bottom: 1rem;
  }

  .wwd-diamond { font-size: 0.4rem; line-height: 1; }

  .wwd-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.55rem;
    background: rgba(249, 115, 22, 0.07);
    border: 1px solid rgba(249, 115, 22, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .wwd-name {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: rgb(250 250 250);
    margin: 0 0 0.5rem;
  }

  .wwd-card--featured .wwd-name { font-size: 1.3rem; }

  .wwd-desc {
    font-size: 0.85rem;
    color: rgb(161 161 170);
    line-height: 1.6;
    flex: 1;
    margin: 0 0 1.25rem;
  }

  .wwd-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgb(113 113 122);
    transition: color 0.2s ease;
    margin-top: auto;
  }

  .wwd-card:hover .wwd-cta { color: rgb(251 146 60); }
  .wwd-card--featured .wwd-cta { color: rgb(251 146 60); }
  .wwd-card--featured:hover .wwd-cta { color: rgb(253 186 116); }

  /* ── Engagement strip ── */
  .eng-strip {
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid rgba(39, 39, 42, 0.5);
  }

  .eng-label {
    text-align: center;
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(113 113 122);
    margin: 0 0 1.25rem;
  }

  .eng-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
  }

  .eng-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.95rem 1.2rem;
    border-radius: 0.65rem;
    background: rgba(24, 24, 27, 0.55);
    border: 1px solid rgba(39, 39, 42, 0.7);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.2s ease;
  }

  .eng-card:hover {
    border-color: rgba(249, 115, 22, 0.3);
    transform: translateY(-2px);
  }

  .eng-card--featured {
    border-color: rgba(249, 115, 22, 0.28);
  }

  .eng-name {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: rgb(228 228 231);
  }

  .eng-card--featured .eng-name { color: rgb(251 146 60); }

  .eng-desc {
    font-size: 0.75rem;
    color: rgb(113 113 122);
  }

  /* ═══════════ Team ═══════════ */
  .team-section {
    padding: 6.5rem 0;
    background: rgb(9 9 11);
    border-top: 1px solid rgba(39, 39, 42, 0.5);
    position: relative;
    overflow: hidden;
  }

  .team-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
  }

  .team-rows {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .team-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .team-card {
    flex: 1 1 14rem;
    text-align: center;
    padding: 2rem 1.1rem 1.75rem;
    border-radius: 0.875rem;
    background: rgba(24, 24, 27, 0.65);
    border: 1px solid rgba(39, 39, 42, 0.75);
    transition: border-color 0.28s ease, transform 0.22s ease;
  }

  .team-card:hover {
    border-color: rgba(249, 115, 22, 0.3);
    transform: translateY(-4px);
  }

  /* Photo — ember ring, monochrome that warms to full colour on hover */
  .team-photo-ring {
    display: inline-block;
    padding: 3px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(249,115,22,0.6), rgba(249,115,22,0.15));
    margin-bottom: 1.15rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .team-photo {
    display: block;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgb(9 9 11);
    filter: grayscale(1) contrast(1.02);
    transition: filter 0.35s ease;
  }

  .team-card:hover .team-photo {
    filter: grayscale(0);
  }

  /* Initials placeholder — same footprint as a photo */
  .team-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1f1a17, #141010);
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: rgb(251 146 60);
    letter-spacing: 0.03em;
    filter: none;
  }

  .team-name {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: rgb(250 250 250);
    margin: 0 0 0.3rem;
  }

  .team-role {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgb(251 146 60);
    margin: 0;
    line-height: 1.4;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .wwd-grid { grid-template-columns: repeat(2, 1fr); }
    .wwd-card--featured { grid-column: span 2; }
  }

  @media (max-width: 680px) {
    .team-card { flex: 1 1 14rem; }
  }

  @media (max-width: 640px) {
    .wwd-section { padding: 5rem 0; }
    .team-section { padding: 5rem 0; }
    .wwd-grid, .eng-row { grid-template-columns: 1fr; }
    .wwd-card--featured { grid-column: span 1; }
    .wwd-container, .team-container { padding: 0 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function setupReveal() {
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const index = parseInt(el.dataset.reveal ?? '0', 10);
          setTimeout(() => el.classList.add('is-visible'), (index % 6) * 90);
          observer.unobserve(el);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
    );
    els.forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', setupReveal);
  document.addEventListener('astro:page-load', setupReveal);
</script>
