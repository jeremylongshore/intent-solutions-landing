---
import DirectoryLayout from '../layouts/DirectoryLayout.astro';
import { experiences, categories } from '../data/public-experiences.mjs';
---
<DirectoryLayout title="Explore Intent Solutions" description="Find a tool, play a game, explore a workflow or learn how we build. Start with what you want to do.">
  <nav class="quick-start" aria-label="Popular places to start">
    <a href="https://oma.intentsolutions.io/the-beacon-wakes/">Find the typing game</a>
    <a href="https://learn.intentsolutions.io/">Learn &amp; practice</a>
    <a href="https://demos.intentsolutions.io/intentoutreach/">Explore real-estate workflows</a>
  </nav>
  <p class="directory-note">Each entry tells you what is available: a product, a demo, a reference or a project in development. Open its page for details and access requirements.</p>
  <div id="discovery-controls" hidden>
    <div class="discovery-fields">
      <div><label for="experience-search">What are you looking for?</label><input id="experience-search" type="search" placeholder="Try typing, real estate, migration or AI learning" autocomplete="off" /></div>
      <div><label for="experience-category">Browse by interest</label><select id="experience-category"><option value="all">Everything</option>{categories.map(({id,label}) => <option value={id}>{label}</option>)}</select></div>
    </div>
    <p id="discovery-count" role="status" aria-live="polite">Showing all {experiences.length} entries.</p>
  </div>
  <noscript><p>All entries are listed below. Use your browser's Find command to look for a topic.</p></noscript>
  <div id="discovery-empty" hidden><h2>No matching entries</h2><p>Try a broader word or browse everything.</p><button type="button" id="discovery-reset">Show everything</button></div>
  <ul class="experience-list" aria-label="Public tools, projects and collections">
    {experiences.map((item) => <li class="experience" data-experience={item.id} data-category={item.category} data-search={[item.name,item.description,item.audience,...item.tags].join(' ').toLowerCase()}>
      <div class="experience-heading"><h2><a href={item.href}>{item.name}</a></h2><span class="availability">{item.status}</span></div>
      <p>{item.description}</p>
      <p class="audience">For {item.audience}</p>
      <div class="experience-actions"><a class="experience-primary" href={item.href}>{item.action}<span class="sr-only">: {item.name}</span> <span aria-hidden="true">→</span></a>{item.links.map((link) => <a href={link.href}>{link.label}<span class="sr-only"> — {item.name}</span></a>)}</div>
    </li>)}
  </ul>
  <section class="explore-help" aria-labelledby="explore-help-title">
    <h2 id="explore-help-title">Have something else in mind?</h2>
    <p>Tell us what your team needs to do. We can help scope a workflow around your information, tools and way of working.</p>
    <a class="route-action" href="/contact/?door=outcome">Describe your project</a>
    <a class="route-action" href="/estate/">How the company connects</a>
    <a class="route-action" href="/site-map/">Company site map</a>
  </section>
</DirectoryLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#experience-search');
  const select = document.querySelector<HTMLSelectElement>('#experience-category');
  const count = document.querySelector('#discovery-count');
  const empty = document.querySelector<HTMLElement>('#discovery-empty');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-experience]'));
  const normalize = (text: string) => text.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '');
  if (search && select && count && empty) {
    const update = () => {
      const terms = normalize(search.value.trim()).split(/\s+/).filter(Boolean);
      let visible = 0;
      items.forEach((item) => {
        const matches = (select.value === 'all' || item.dataset.category === select.value)
          && terms.every((term) => normalize(item.dataset.search || '').includes(term));
        item.hidden = !matches;
        if (matches) visible++;
      });
      count.textContent = `Showing ${visible} of ${items.length} entries.`;
      empty.hidden = visible !== 0;
    };
    search.addEventListener('input', update);
    select.addEventListener('change', update);
    document.querySelector('#discovery-reset')?.addEventListener('click', () => {
      search.value = ''; select.value = 'all'; update(); search.focus();
    });
    document.querySelector<HTMLElement>('#discovery-controls')!.hidden = false;
    update();
  }
</script>
<style>
  .quick-start { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; margin:1.5rem 0; }
  .quick-start a { min-height:44px; display:inline-flex; align-items:center; font-weight:600; }
  .directory-note { margin:1rem 0 2rem; }
  .discovery-fields { display:grid; grid-template-columns:2fr 1fr; gap:1rem; }
  .discovery-fields > div { min-width:0; }
  label { display:block; font-weight:600; margin-bottom:.5rem; }
  input, select { width:100%; min-height:48px; padding:.75rem; background:#18181b; color:#fafafa; border:1px solid #71717a; border-radius:.4rem; font:inherit; font-size:16px; }
  input::placeholder { color:#a1a1aa; }
  input:focus-visible, select:focus-visible, button:focus-visible { outline:2px solid #fb923c; outline-offset:3px; }
  #discovery-count { margin:1rem 0; }
  .experience-list { list-style:none; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:0 2rem; }
  .experience { min-width:0; padding:1.5rem 0; border-top:1px solid #3f3f46; }
  .experience[hidden], [hidden] { display:none !important; }
  .experience-heading { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:.5rem; }
  .experience h2 { margin:0; font-size:1.3rem; line-height:1.4; }
  .experience h2 a { display:inline-flex; align-items:center; min-height:44px; }
  .availability { display:inline-block; color:#d4d4d8; border:1px solid #52525b; border-radius:.3rem; padding:.25rem .5rem; font-size:.75rem; }
  .experience p { margin:.5rem 0; }
  .experience .audience { font-size:.85rem; color:#a1a1aa; }
  .experience-actions { display:flex; flex-wrap:wrap; gap:0 1rem; }
  .experience-actions a { display:inline-flex; align-items:center; gap:.3rem; min-height:44px; font-size:.9rem; }
  .experience-primary { font-weight:600; }
  .explore-help { margin-top:2rem; border-top:1px solid #3f3f46; }
  button { min-height:44px; padding:.6rem 1rem; border:1px solid #fb923c; border-radius:.4rem; color:#fafafa; cursor:pointer; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(max-width:640px) { .discovery-fields, .experience-list { grid-template-columns:1fr; } }
</style>
