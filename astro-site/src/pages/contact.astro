---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Contact from '../components/Contact';
import Footer from '../components/Footer';
import '../styles/contact.css';
---

<Layout
  title="Request an Outcome | Intent Solutions"
  description="Tell Intent Solutions what must change, where the system must run, and what evidence would prove the outcome."
>
  <SiteNav />
  <main class="contact-page">
    <div class="contact-wrap">
      <a href="/" class="contact-back">&larr; Back to Home</a>
      <header class="contact-intro">
        <h1>Request an outcome</h1>
        <p>Tell us what must change, where the system must run, and what evidence would make you trust the result.</p>
      </header>
      <noscript><p class="contact-nojs">The form needs JavaScript to submit. You can email <a href="mailto:support@intentsolutions.io">support@intentsolutions.io</a> instead.</p></noscript>
      <Contact client:load />
    </div>
  </main>
  <Footer />
</Layout>
