---
import Layout from '../layouts/Layout.astro';
import privacyPolicy from '../content/legal/privacy-policy.html?raw';
---

<Layout title="Privacy Policy - intent solutions io">
  <section class="privacy-page" aria-labelledby="privacy-title">
    <h1 id="privacy-title">Privacy Policy</h1>
    <!-- Existing published GetTerms policy, captured October 17, 2026.
         See 000-docs/090-AT-MAINT-privacy-policy-rendering.md for provenance. -->
    <article class="privacy-policy" aria-label="Privacy policy" set:html={privacyPolicy} />
  </section>
</Layout>

<style>
  .privacy-page { max-width: 54rem; margin: 0 auto; padding: 5rem 1.5rem; }
  h1 { color: #fafafa; font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.15; margin-bottom: 2.5rem; }
  .privacy-policy { color: #d4d4d8; line-height: 1.75; overflow-wrap: anywhere; }
  .privacy-policy :global(h2), .privacy-policy :global(h3) { color: #fafafa; line-height: 1.3; margin: 2rem 0 1rem; }
  .privacy-policy :global(h2) { font-size: 1.5rem; }
  .privacy-policy :global(h3) { font-size: 1.2rem; }
  .privacy-policy :global(p), .privacy-policy :global(ul) { margin: 1rem 0; }
  .privacy-policy :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .privacy-policy :global(li) { margin: .4rem 0; }
  .privacy-policy :global(a) { color: #fdba74; text-decoration: underline; text-underline-offset: .2em; }
</style>
