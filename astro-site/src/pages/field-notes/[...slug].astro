---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('field-notes');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: 'Jeremy Longshore',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Intent Solutions',
    url: 'https://intentsolutions.io',
  },
  mainEntityOfPage: post.data.canonical || `https://intentsolutions.io/field-notes/${post.id.replace(/\.md$/, '')}`,
};
---

<Layout
  title={`${post.data.title} | Field Notes`}
  description={post.data.description}
  canonical={post.data.canonical}
>
  <SiteNav />

  <main class="min-h-screen bg-[var(--intent-ink)]">
    <article class="py-16 sm:py-24">
      <div class="container mx-auto px-6 sm:px-8 max-w-3xl">
        <a
          href="/field-notes/"
          class="inline-flex items-center gap-1.5 text-sm text-[var(--intent-faint)] hover:text-[var(--intent-muted)] transition-smooth mb-10"
        >
          &larr; Field Notes
        </a>

        <header class="mb-12">
          <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--intent-faint)] mb-4">
            <time datetime={post.data.date}>{formattedDate}</time>
            {post.data.tags && post.data.tags.length > 0 && (
              <>
                <span class="text-[var(--intent-text)]">&middot;</span>
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--intent-surface)] text-[var(--intent-faint)] border border-[var(--intent-line)]">
                      {tag}
                    </span>
                  ))}
                </div>
              </>
            )}
          </div>
          <h1 class="text-h1 font-bold text-[var(--intent-text)] mb-4">{post.data.title}</h1>
          <p class="text-body-lg text-[var(--intent-muted)]">{post.data.description}</p>
        </header>

        <div class="prose-field-notes">
          <Content />
        </div>
      </div>
    </article>
  </main>

  <Footer client:load />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

