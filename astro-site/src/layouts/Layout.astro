---
import '../styles/global.css';
import { SEO } from 'astro-seo';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Model-agnostic AI agents, private AI infrastructure, and workflow automation. Vertex-first security, discovery-led engagements, no vendor lock-in.',
  ogImage = `${Astro.site}og-image.svg`,
  canonical,
  noindex = false,
} = Astro.props;

// Use explicit canonical if provided (syndicated content), otherwise generate from current URL
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();

// Site-level structured data (emitted once on every page). Organization +
// WebSite establish the brand entity and enable sitelinks search box / brand
// knowledge panel. Claims kept accurate — no LocalBusiness/address.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://intentsolutions.io';
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Intent Solutions',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/favicon.svg`,
    sameAs: [
      'https://github.com/jeremylongshore',
      'https://linkedin.com/in/jeremylongshore',
      'https://claudecodeplugins.io',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Intent Solutions',
    url: `${siteUrl}/`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: ogImage,
          url: canonicalURL,
        },
        optional: {
          description: description,
          siteName: 'intent solutions io',
        }
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: ogImage,
      }}
    />

    <!-- Site-level structured data (Organization + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

    <!-- Umami analytics — self-hosted at analytics.intentsolutions.io (Intent
         Solutions VPS). Replaces the Firebase Analytics block on 2026-06-10 to
         remove the last GCP dependency from the marketing site. Umami auto-
         tracks page views; emit custom events with window.umami.track(name, props). -->
    <script
      defer
      src="https://analytics.intentsolutions.io/script.js"
      data-website-id="474bce85-f97d-409c-aba5-1e1ff36ee571"
      data-domains="intentsolutions.io"
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>
