---
// A published policy rendered as static HTML. The body is the captured GetTerms
// document (see 000-docs/090-AT-MAINT-privacy-policy-rendering.md and
// 000-docs/091-AT-MAINT-terms-and-acceptable-use-rendering.md); its wording is
// never edited here. Approved policy changes replace the source file and its
// browser-test digest together.
interface Props {
  id: string;
  title: string;
  html: string;
}
const { id, title, html } = Astro.props;
---

<section class="legal-page" aria-labelledby={`${id}-title`}>
  <h1 id={`${id}-title`}>{title}</h1>
  <article class="legal-document" aria-label={title} set:html={html} />
</section>

<style>
  .legal-page { max-width: 54rem; margin: 0 auto; padding: 5rem 1.5rem; }
  h1 { color: var(--intent-text); font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.15; margin-bottom: 2.5rem; overflow-wrap: break-word; min-width: 0; }
  .legal-document { color: var(--intent-text-2); line-height: 1.75; overflow-wrap: anywhere; }
  .legal-document :global(h2), .legal-document :global(h3) { color: var(--intent-text); line-height: 1.3; margin: 2rem 0 1rem; }
  .legal-document :global(h2) { font-size: 1.5rem; }
  .legal-document :global(h3) { font-size: 1.2rem; }
  .legal-document :global(p), .legal-document :global(ul), .legal-document :global(ol) { margin: 1rem 0; }
  .legal-document :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .legal-document :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .legal-document :global(ol[type="i"]) { list-style: lower-roman; }
  .legal-document :global(li) { margin: .4rem 0; }
  .legal-document :global(a) { color: var(--intent-accent-hi); text-decoration: underline; text-underline-offset: .2em; }
</style>
